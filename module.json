{
  "id": "fuzzing",
  "version": "0.7.0",
  "api": 2,
  "storage": {
    "lineage": "fuzzing.v1",
    "schema": "1.1.0",
    "upgradeCleanup": "upgrade-clean.mjs"
  },
  "agents": [
    {
      "name": "fuzzing",
      "role": "fuzzing",
      "start": "manual"
    }
  ],
  "requires": {
    "proxy.traffic.read": "^1.0.0"
  },
  "server": "src/index.mjs",
  "toolOverrides": {
    "fuzz_run": {
      "mode": "extend",
      "contract": "^2.0.0"
    },
    "fuzz_result": {
      "mode": "extend",
      "contract": "^2.0.0"
    }
  },
  "skills": [
    {
      "name": "fuzzing",
      "source": "skills/fuzzing"
    }
  ],
  "migrations": [
    "001-schema.sql",
    "002-wordlist-tasks.sql"
  ],
  "assets": [
    {
      "source": "agents/fuzzing.toml",
      "target": ".codex/agents/fuzzing.toml"
    }
  ],
  "dependencies": {
    "ffuf": {
      "version": "2.3.0"
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "activeDiscovery": {
        "type": "boolean",
        "description": "Allow the specialist to propose/initiate autonomous discovery within its assigned scope. Explicit fuzz_run calls are not gated by this preference."
      },
      "ffufDefaults": {
        "type": "object",
        "description": "Defaults for omitted ffuf options; explicit options win. Wordlists are never inherited from defaults."
      },
      "wordlistLibraries": {
        "type": "array",
        "description": "Additional container directories containing shared wordlists. These are cataloged as internal/bundled or external; no files are copied or downloaded.",
        "items": {
          "type": "object",
          "required": [
            "path",
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "internal",
                "external"
              ]
            },
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "additionalProperties": false
  },
  "workers": {
    "wordlist_export": "workers/wordlist_export.mjs",
    "wordlist_read": "workers/wordlist_read.mjs",
    "ffuf_results": "workers/ffuf_results.mjs",
    "wordlist_catalog": "workers/wordlist_catalog.mjs"
  },
  "dashboard": {
    "api": 1,
    "components": [
      {
        "id": "runs",
        "title": "Runs",
        "scope": "workspace",
        "entry": "dashboard/workspace.mjs"
      },
      {
        "id": "wordlists",
        "title": "Wordlists",
        "scope": "workspace",
        "entry": "dashboard/workspace.mjs"
      }
    ]
  }
}
